# The SDK refuses non-loopback URLs. Keep the standalone server local.
TRUEFORGE_BASE_URL=http://127.0.0.1:8790

# Verdict configures Hugging Face as a custom OpenAI-compatible provider.
# The model name below resolves to Qwen3.8-27B through Featherless AI.
TRUEFORGE_MODEL=huggingface/qwen3.8-27b

# Fine-grained token with "Make calls to Inference Providers" permission.
# Stored only in TrueForge's model-provider settings.
HF_TOKEN=

# Optional authentication for the TrueForge server itself.
TRUEFORGE_TOKEN=

# Stored only in TrueForge's redacted Daytona sandbox-provider settings.
DAYTONA_API_KEY=

# Fine-grained PAT only. Select the himanshu748/verdict repository instead of
# granting access to every private repository on the account. Grant repository
# metadata read, contents read, issues read, actions read/write and pull
# requests read. The connector can still inspect public TrueForge evidence.
# Stored only as the GitHub MCP connector's Authorization header.
GITHUB_TOKEN=

# The public issue Verdict investigates.
VERDICT_ISSUE_REPOSITORY=truefoundry/trueforge
VERDICT_ISSUE_NUMBER=417

# Trusted host policy for the only workflow call a maintainer may approve.
# These values are application configuration, never model-generated input.
VERDICT_WORKFLOW_OWNER=himanshu748
VERDICT_WORKFLOW_REPO=verdict
VERDICT_WORKFLOW_ID=verdict-day4-proof.yml
VERDICT_WORKFLOW_REF=main
